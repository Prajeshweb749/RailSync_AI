# RailSync AI — Environment Configuration Template
# Copy this file to .env and provide your actual environment credentials.
# NEVER commit the active .env file to public version control.

# RailRadar Live Telemetry API
RAILRADAR_API_KEY=your_railradar_api_key_here
RAILRADAR_BASE_URL=https://api.railradar.in/v1

# PostgreSQL Database Connection
# Format: postgresql://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/railway_db
